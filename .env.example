NODE_ENV=development
PORT=3333

# --- Local PostgreSQL (Compose) ---
# These four values are the single source of truth for `docker compose`.
# Postgres only applies POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB on the
# FIRST volume init. After changing them, run: docker compose down -v && docker compose up -d
POSTGRES_HOST_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=monolith_db

# App / Prisma connection (host-run Node). User, password and DB name MUST match
# POSTGRES_* above. Host is localhost; port is POSTGRES_HOST_PORT.
# URL-encode special characters in the password (@ → %40, # → %23, etc.).
DATABASE_URL=postgresql://user:password@localhost:5432/monolith_db

# Minimum 32 characters
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Optional in development; required and independent in production
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret-at-least-32-chars

# Default tenant created by `npm run db:seed`
DEFAULT_TENANT_ID=00000000-0000-4000-8000-000000000001

# Queue: memory (local) | bullmq (production with Redis)
QUEUE_DRIVER=memory

# Token revocation: memory (single process) | redis (shared across instances).
# When omitted, follows QUEUE_DRIVER for backward compatibility.
TOKEN_REVOCATION_DRIVER=memory
REDIS_URL=redis://localhost:6379

# Password hashing: argon2 (default) | bcrypt
HASH_ALGORITHM=argon2

# HTTP hardening
# Comma-separated allowlist. Wildcard is accepted only outside production.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Observability (stub — wire OTLP exporter in production)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ts-monolith

# Enable full DB e2e tests locally (always on in CI)
# E2E_TESTS=true
